# Caddy + edge-apps (docker-compose.edge-apps.yml, AGENT_CMS_EDGE_APPS=1)
# Env: AGENT_CMS_PUBLIC_DOMAIN, AGENT_CMS_CADDY_EMAIL
# apex + qwenpaw + all → HTTPS (Let's Encrypt).
# Прочие *.domain → заглушка (HTTP + HTTPS с tls internal, пока нет DNS-01 wildcard).

{
	email {$AGENT_CMS_CADDY_EMAIL}
}

(cms_proxy) {
	handle_errors {
		@upstream expression {http.error.status_code} >= 502 && {http.error.status_code} <= 503
		handle @upstream {
			root * /srv/caddy-errors
			rewrite * /upstream-unavailable.html
			file_server
		}
	}
	handle {
		reverse_proxy cms:3000
	}
}

(edge_all_static) {
	root * /srv/edge-static/all
	rewrite * /index.html
	file_server
}

(edge_unknown_static) {
	root * /srv/edge-static/unknown
	rewrite * /index.html
	file_server
}

qwenpaw.{$AGENT_CMS_PUBLIC_DOMAIN} {
	reverse_proxy qwenpaw:8088
}

all.{$AGENT_CMS_PUBLIC_DOMAIN} {
	import edge_all_static
}

{$AGENT_CMS_PUBLIC_DOMAIN} {
	import cms_proxy
}

# Неизвестные поддомены — только HTTP (явный site надёжнее matcher в :80).
http://*.{$AGENT_CMS_PUBLIC_DOMAIN} {
	import edge_unknown_static
}

# HTTPS для случайных *.domain — внутренний cert (браузер может спросить «доверять»).
# Явные qwenpaw / all / apex выше — точное совпадение host, не этот блок.
*.{$AGENT_CMS_PUBLIC_DOMAIN} {
	tls internal
	import edge_unknown_static
}

# Локально / по IP без Host поддомена:
:80 {
	import cms_proxy
}
