# Caddy + edge-apps (docker-compose.edge-apps.yml, AGENT_CMS_EDGE_APPS=1)
# Env: AGENT_CMS_PUBLIC_DOMAIN, AGENT_CMS_CADDY_EMAIL
# Apex + qwenpaw + all → HTTPS. Неизвестный поддомен (foo.*) → заглушка только по HTTP :80.

{
	email {$AGENT_CMS_CADDY_EMAIL}
}

(cms_proxy) {
	handle_errors {
		@upstream expression {http.error.status_code} >= 502 && {http.error.status_code} <= 503
		handle @upstream {
			root * /srv/caddy-errors
			rewrite * /upstream-unavailable.html
			file_server
		}
	}
	handle {
		reverse_proxy cms:3000
	}
}

(edge_all_static) {
	root * /srv/edge-static/all
	rewrite * /index.html
	file_server
}

(edge_unknown_static) {
	root * /srv/edge-static/unknown
	rewrite * /index.html
	file_server
}

qwenpaw.{$AGENT_CMS_PUBLIC_DOMAIN} {
	reverse_proxy qwenpaw:8088
}

all.{$AGENT_CMS_PUBLIC_DOMAIN} {
	import edge_all_static
}

{$AGENT_CMS_PUBLIC_DOMAIN} {
	import cms_proxy
}

# :80 — неизвестные *.domain (HTTP, без TLS) + IP / прочие → CMS
:80 {
	@unknown_sub expression `{http.request.host}.endsWith(".{$AGENT_CMS_PUBLIC_DOMAIN}") && {http.request.host} != "qwenpaw.{$AGENT_CMS_PUBLIC_DOMAIN}" && {http.request.host} != "all.{$AGENT_CMS_PUBLIC_DOMAIN}" && {http.request.host} != "{$AGENT_CMS_PUBLIC_DOMAIN}"`
	handle @unknown_sub {
		import edge_unknown_static
	}
	handle {
		import cms_proxy
	}
}
