# Agent CMS на VPS — Let's Encrypt через Caddy
# Скопировать: sudo cp docs/deploy/caddy-maptex.Caddyfile /etc/caddy/Caddyfile
# Проверка: sudo caddy validate --config /etc/caddy/Caddyfile
# Применить: sudo systemctl reload caddy
#
# DNS: maptex.ru → A → IP VPS (уже настроено в Beget)
# На сервере CMS слушает только localhost:
#   HOST=127.0.0.1 npm start   (или agent-cms-http-service.sh)
#   AGENT_CMS_MCP_HTTP_HOST=127.0.0.1 npm run mcp:http
#
# Фаервол: 22, 80, 443 — да; 3000, 3288, 3490 — только localhost (не наружу)

maptex.ru {
	# MCP для Claude / Cursor (Streamable HTTP)
	handle /mcp* {
		reverse_proxy 127.0.0.1:3490
	}

	# Agent CMS Editor (+ /commander/ на том же процессе)
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# Опционально: Control Launcher
# control.maptex.ru {
# 	reverse_proxy 127.0.0.1:3288
# }
