# Agent CMS на VPS — Let's Encrypt через Caddy
#   cd /opt/agent-cms && sudo bash docs/deploy/install-caddy-maptex.sh
#
# DNS: maptex.ru → A → IP VPS
# CMS: 127.0.0.1:3000   MCP: 127.0.0.1:3490
# Если видите «Caddy works!» — это дефолтный конфиг, замените этим файлом.

{
	email admin@maptex.ru
}

maptex.ru {
	# MCP для Claude / Cursor (Streamable HTTP)
	handle /mcp* {
		reverse_proxy 127.0.0.1:3490
	}

	# Agent CMS Editor (+ /commander/ на том же процессе)
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# Опционально: Control Launcher
# control.maptex.ru {
# 	reverse_proxy 127.0.0.1:3288
# }
