# Caddy внутри Docker Compose (docker-compose.prod.yml / docker-compose.caddy.yml)
# Env: AGENT_CMS_PUBLIC_DOMAIN, AGENT_CMS_CADDY_EMAIL

{
	email {$AGENT_CMS_CADDY_EMAIL}
}

{$AGENT_CMS_PUBLIC_DOMAIN} {
	handle /mcp* {
		reverse_proxy mcp:3490
	}
	handle /app-mcp* {
		uri replace /app-mcp /mcp
		reverse_proxy mcp:3490
	}
	handle {
		reverse_proxy cms:3000
	}
}

# Локально без DNS:
:80 {
	handle /mcp* {
		reverse_proxy mcp:3490
	}
	handle /app-mcp* {
		uri replace /app-mcp /mcp
		reverse_proxy mcp:3490
	}
	handle {
		reverse_proxy cms:3000
	}
}
