# Caddy внутри Docker Compose (docker-compose.linux.yml)
# Env: AGENT_CMS_PUBLIC_DOMAIN, AGENT_CMS_CADDY_EMAIL
# Одна дверь снаружи: весь HTTP(S) → CMS; /app-mcp и остальные app-* проксирует server.js.

{
	email {$AGENT_CMS_CADDY_EMAIL}
}

{$AGENT_CMS_PUBLIC_DOMAIN} {
	handle {
		reverse_proxy cms:3000
	}
}

# Локально без DNS:
:80 {
	handle {
		reverse_proxy cms:3000
	}
}
