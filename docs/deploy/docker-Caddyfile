# Caddy внутри Docker Compose (docker-compose.linux.yml)
# Env: AGENT_CMS_PUBLIC_DOMAIN, AGENT_CMS_CADDY_EMAIL
# Одна дверь снаружи: весь HTTP(S) → CMS; /app-mcp и остальные app-* проксирует server.js.

{
	email {$AGENT_CMS_CADDY_EMAIL}
}

(cms_upstream_errors) {
	handle_errors {
		@upstream expression {http.error.status_code} >= 502 && {http.error.status_code} <= 503
		handle @upstream {
			root * /srv/caddy-errors
			rewrite * /upstream-unavailable.html
			file_server
		}
	}
}

(cms_proxy) {
	import cms_upstream_errors
	handle {
		reverse_proxy cms:3000
	}
}

{$AGENT_CMS_PUBLIC_DOMAIN} {
	import cms_proxy
}

# Локально без DNS:
:80 {
	import cms_proxy
}
