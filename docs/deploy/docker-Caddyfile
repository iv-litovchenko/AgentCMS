# Caddy внутри Docker Compose (docker-compose.prod.yml / docker-compose.caddy.yml)
# Env: MAPTEX_DOMAIN, CADDY_EMAIL

{
	email {$CADDY_EMAIL}
}

{$MAPTEX_DOMAIN} {
	handle /mcp* {
		reverse_proxy mcp:3490
	}
	handle {
		reverse_proxy cms:3000
	}
}

# Локально без DNS:
:80 {
	handle /mcp* {
		reverse_proxy mcp:3490
	}
	handle {
		reverse_proxy cms:3000
	}
}
