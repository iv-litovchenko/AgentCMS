{
  "manifest_version": 3,
  "name": "Agent Shell Companion",
  "short_name": "Agent Shell",
  "version": "0.1.96",
  "description": "Side panel Agent Shell on any website — connects to local Agent CMS.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab",
    "tabs",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src 'self' http://localhost:* http://127.0.0.1:* https://localhost:* https://127.0.0.1:*;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent Shell Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "web_accessible_resources": [
    {
      "resources": [
        "panel-host.html",
        "panel-host.js",
        "toolbar-inner.css",
        "icons/brands/yandex.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "companion-urls-global.js",
        "clipboard-history.js",
        "companion-pomodoro-global.js",
        "companion-pomodoro-overlay.js",
        "companion-pomodoro-toolbar.js",
        "companion-crosshair.js",
        "companion-screenshot-annotate.js",
        "companion-vault-switcher.js",
        "companion-bookmarks-draft.js",
        "web-search-catalog-global.js",
        "toolbar-css.js",
        "content-script.js",
        "companion-media-hover-save.js",
        "companion-iframe-open.js",
        "companion-voice-relay.js",
        "companion-file-hub-buffer.js",
        "companion-file-hub-page.js"
      ],
      "css": ["content-script.css", "companion-pomodoro-break.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["page-picker-extract.js", "page-snapshot.js", "page-picker.js"],
      "css": ["content-script.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
