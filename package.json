{
  "name": "agent-cms",
  "version": "0.1.0",
  "private": true,
  "description": "File-based CMS prototype for agents (no database)",
  "author": "Agent CMS",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "mcp": "node mcp-server/index.js",
    "postinstall": "mkdir -p public/vendor && cp node_modules/markdown-it/dist/markdown-it.min.js public/vendor/markdown-it.min.js && cp node_modules/mermaid/dist/mermaid.min.js public/vendor/mermaid.min.js && cp node_modules/@toast-ui/editor/dist/toastui-editor.css public/vendor/toastui-editor.css && curl -fsSL https://uicdn.toast.com/editor/3.2.2/toastui-editor-all.min.js -o public/vendor/toastui-editor-all.min.js",
    "desktop": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "open:app": "open \"dist/mac/Agent CMS.app\""
  },
  "dependencies": {
    "@toast-ui/editor": "^3.2.2",
    "electron-updater": "^6.6.2",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.15.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.agentcms.desktop",
    "productName": "Agent CMS",
    "icon": "electron/assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "agent-registry.js",
      "api-docs.js",
      "mcp-docs.js",
      "mcp-server/**/*",
      "awn-agents.json",
      "Workspaces/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "Agent CMS",
        "schemes": [
          "agentcms"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/assets/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "electron/assets/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "electron/assets/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com/agent-cms-updates/"
    }
  }
}
