# Agent CMS — схема ключей (MCP platform_env_*, whitelist). Рабочий конфиг — .env в репозитории.
# Сервер (Mac и VPS): только Docker — npm run docker:mac · npm run docker:linux
# Electron (.app) вне Docker; ходит на AGENT_CMS_PUBLIC_URL
# Mac: PUBLIC_URL ниже. VPS: замените DOMAIN, CADDY_EMAIL, PUBLIC_URL на https://ваш-домен

# --- App lock (Control, ops, env MCP write) ---
APP_LOCK_LOGIN=admin
APP_LOCK_PASSWORD=changeme
# UI-app под паролем (как platform_apps_list, без mcp). Уберите id, если зона без lock.
APP_LOCK_APPS=editor,chat,commander,control

# --- HTTP → HTTPS (внутри CMS; на VPS с Caddy обычно 0 — редирект делает Caddy) ---
# 1 = пока поднимаете HTTPS (mkcert / start:https) или хотите редирект с :3000 на :3443
AGENT_CMS_HTTP_TO_HTTPS=0

# --- Workspaces (один каталог на хосте; новые ws-* = новая подпапка, compose не меняем) ---
# По умолчанию ./workspaces в репо. Свои данные: абсолютный путь на Mac/Linux.
# AGENT_CMS_WORKSPACES_DIR=/Users/you/AgentCMS-workspaces

# --- Публичный адрес (app-*, MCP registry, клиенты) ---
AGENT_CMS_PUBLIC_URL=http://127.0.0.1:3000
# Одна HTTP-дверь: UI/API по /app-* на CMS (0 = отдельные порты dev)
AGENT_CMS_SINGLE_HTTP_DOOR=1
# AGENT_CMS_EXPOSE_INTERNAL_PORTS=1
AGENT_CMS_SITE_TITLE=Agent CMS
AGENT_CMS_PUBLIC_DOMAIN=localhost
AGENT_CMS_CADDY_EMAIL=admin@example.com
# Edge-сервисы на поддоменах (qwenpaw.*, all.*); выключить: 0
AGENT_CMS_EDGE_SERVICES_ENABLED=1
# Mac: qwenpaw.localhost / all.localhost через CMS :3000 (docker-compose.edge-services.mac.yml)
# AGENT_CMS_EDGE_HTTP_GATE=1
# Данные edge-сервисов: workspaces/<dir>/<service-id>/ (отдельный «служебный» workspace)
AGENT_CMS_SERVICES_DATA_DIR=0-services-data
# v1 (не v0): реестр edge-сервисов → автоген compose/Caddy — см. TODO-REFACTOR-15 §10.8
# AGENT_CMS_EDGE_SERVICES_MANIFEST=.agent-cms-global/edge-services.json
# AGENT_CMS_EDGE_SERVICES_GENERATE=0

# --- MCP (…/app-mcp + Bearer) ---
# VPS: AGENT_CMS_PUBLIC_URL=https://ваш-домен — icons в Claude → https://ваш-домен/app-mcp/icon
AGENT_CMS_MCP_TOKEN=changeme-mcp-token
# AGENT_CMS_MCP_ICON_URL=https://ваш-домен/app-mcp/icon
AGENT_CMS_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Max decoded bytes for MCP base64 uploads (content_binary_write / content_write data=…); default 1048576 (1 MiB)
# AGENT_CMS_MCP_BASE64_MAX_BYTES=1048576
# Default page size for MCP contents_list_* (decoded list limit, max 100)
# AGENT_CMS_LIST_DEFAULT_LIMIT=20
# AGENT_CMS_LIST_DEFAULT_MAX_DEPTH=3
# AGENT_CMS_LIST_ALLOW_PREVIEW=0

# --- Control: git pull + rebuild (1 = включить кнопку «Обновить») ---
AGENT_CMS_DEPLOY_UPDATE_ENABLED=0
# Платформа хоста для UI Control (mac | linux | windows). В compose обычно уже задано.
# AGENT_CMS_DEPLOY_PLATFORM=mac

# --- Mac: CLI на хосте (docker-mac-start/rebuild; в контейнеры не попадает) ---
# 1 = после start/rebuild открыть Control в браузере; 0 = только URL в терминале (по умолчанию)
# AGENT_CMS_OPEN_BROWSER=0

# --- Web search (MCP) ---
WEB_SEARCH_MODE=direct
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_LANG=ru
GOOGLE_SEARCH_COUNTRY=RU
GOOGLE_SEARCH_GL=ru
GOOGLE_SEARCH_SAFE=active
