# Agent CMS — схема ключей (MCP platform_env_*, whitelist). Рабочий конфиг — .env в репозитории.
# Сервер (Mac и VPS): только Docker — npm run docker:mac · npm run docker:linux
# Electron (.app) вне Docker; ходит на AGENT_CMS_PUBLIC_URL
# Mac: PUBLIC_URL ниже. VPS: замените DOMAIN, CADDY_EMAIL, PUBLIC_URL на https://ваш-домен

# --- App lock (Control, ops, env MCP write) ---
APP_LOCK_LOGIN=admin
APP_LOCK_PASSWORD=changeme
# UI-app под паролем (как platform_apps_list, без mcp). Уберите id, если зона без lock.
APP_LOCK_APPS=editor,chat,commander,control

# --- HTTP → HTTPS (внутри CMS; на VPS с Caddy обычно 0 — редирект делает Caddy) ---
# 1 = пока поднимаете HTTPS (mkcert / start:https) или хотите редирект с :3000 на :3443
AGENT_CMS_HTTP_TO_HTTPS=0

# --- Публичный адрес (app-*, MCP registry, клиенты) ---
AGENT_CMS_PUBLIC_URL=http://127.0.0.1:3000
# Одна HTTP-дверь: UI/API по /app-* на CMS (0 = отдельные порты dev)
AGENT_CMS_SINGLE_HTTP_DOOR=1
# AGENT_CMS_EXPOSE_INTERNAL_PORTS=1
AGENT_CMS_SITE_TITLE=Agent CMS
AGENT_CMS_PUBLIC_DOMAIN=localhost
AGENT_CMS_CADDY_EMAIL=admin@example.com

# --- MCP (…/app-mcp + Bearer) ---
AGENT_CMS_MCP_TOKEN=changeme-mcp-token
AGENT_CMS_MCP_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Control: git pull + rebuild (1 = включить кнопку «Обновить») ---
AGENT_CMS_DEPLOY_UPDATE_ENABLED=0
# Платформа хоста для UI Control (mac | linux | windows). В compose обычно уже задано.
# AGENT_CMS_DEPLOY_PLATFORM=mac


# --- Web search (MCP) ---
WEB_SEARCH_MODE=direct
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_LANG=ru
GOOGLE_SEARCH_COUNTRY=RU
GOOGLE_SEARCH_GL=ru
GOOGLE_SEARCH_SAFE=active
