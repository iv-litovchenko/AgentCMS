# Локальный замок UI Agent CMS (логин и пароль в открытом виде).
# Если пароль ещё не задан — при первом открытии предложится его создать.
# Можно также задать вручную; тогда при открытии показывается экран входа.

APP_LOCK_LOGIN=admin
APP_LOCK_PASSWORD=changeme

# Порты Agent CMS (Editor = CMS, Voice = голосовой shell).
# Legacy-имена PORT / TLS_PORT / VOICE_PORT / VOICE_TLS_PORT тоже поддерживаются.
# AGENT_CMS_EDITOR_HTTP_PORT=3000
# AGENT_CMS_EDITOR_HTTPS_PORT=3443
# AGENT_CMS_VOICE_HTTP_PORT=3088
# AGENT_CMS_VOICE_HTTPS_PORT=3488
# AGENT_CMS_COMMANDER_HTTP_PORT=3188
# COMMANDER_AUTOSTART=1
# COMMANDER_HOST=127.0.0.1
# AGENT_CMS_CONTROL_HTTP_PORT=3288
# CONTROL_AUTOSTART=1
# CONTROL_HOST=127.0.0.1
# AGENT_CMS_MCP_HTTP_PORT=3490

# Сервер / Docker / LAN (npm run start или compose)
# HOST=0.0.0.0
# VOICE_HOST=0.0.0.0
# AGENT_CMS_HTTP_TO_HTTPS=0
# VOICE_AUTOSTART=1

# MCP Streamable HTTP (npm run mcp:http) — URL для Cursor: http://host:3490/mcp
# AGENT_CMS_MCP_HTTP_HOST=127.0.0.1
# AGENT_CMS_MCP_TOKEN=          # Bearer; обязателен наружу в prod
# MCP за Caddy (https://maptex.ru/mcp):
# AGENT_CMS_MCP_TOKEN=...
# AGENT_CMS_MCP_BEHIND_PROXY=1
# AGENT_CMS_MCP_ALLOWED_HOSTS=maptex.ru,localhost,127.0.0.1

# Docker (docker-compose.linux.yml) — публичный домен для Caddy / HTTPS:
# AGENT_CMS_PUBLIC_DOMAIN=your-domain.example
# AGENT_CMS_CADDY_EMAIL=admin@your-domain.example

# Публичный URL платформы (Editor, app-* ссылки, MCP registry). Пример: https://maptex.ru
# AGENT_CMS_PUBLIC_URL=https://your-domain.example
# AGENT_CMS_SITE_TITLE=Agent CMS
# AGENT_CMS_MCP_INTERNAL_URL=http://127.0.0.1:3490
# AGENT_CMS_EXPOSE_INTERNAL_PORTS=1
# Control в Docker (задаётся в compose): AGENT_CMS_DOCKER_OPS=1, AGENT_CMS_DOCKER_UP_SERVICES=cms mcp

# HTTP→HTTPS для Editor и Voice (0 = выкл). Legacy: HTTPS_REDIRECT=0
# AGENT_CMS_HTTP_TO_HTTPS=1

# Без HTTPS: npm start (только HTTP Editor). С HTTPS: npm run start:https
# AGENT_CMS_BASE_URL=https://localhost:3443
# CMS_API_URL=http://127.0.0.1:3000

# Web search (MCP: search_web, search_web_images, read_web_page)
# direct = scrape google.com HTML (default, no keys). api = Google Custom Search JSON API.
WEB_SEARCH_MODE=direct

# Only for WEB_SEARCH_MODE=api:
# 1) Google Cloud Console → Custom Search API → API key
# 2) https://programmablesearchengine.google.com/ → search engine (Search the entire web)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Опционально (bias результатов)
# GOOGLE_SEARCH_LANG=ru
# GOOGLE_SEARCH_COUNTRY=RU
# GOOGLE_SEARCH_GL=ru
# GOOGLE_SEARCH_SAFE=active
