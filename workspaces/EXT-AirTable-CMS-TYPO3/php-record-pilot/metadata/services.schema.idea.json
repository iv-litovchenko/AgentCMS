{
  "meta": {
    "documentType": "schema-idea",
    "version": "1.0",
    "project": "Universal Admin",
    "entity": "services",
    "purpose": "Идея-спецификация для генерации list/form/filter/import-export в админке",
    "notes": [
      "Это не миграция БД, а слой метаданных поверх существующей схемы",
      "Физическая схема (DB) и UI-описание (Admin Schema) разделены",
      "Можно использовать как исходник для генератора интерфейсов и API"
    ]
  },
  "physicalSchema": {
    "table": "services",
    "primaryKey": "id",
    "titleField": "title",
    "softDeleteField": "deleted_at",
    "timestamps": {
      "createdAt": "created_at",
      "updatedAt": "updated_at"
    },
    "columns": [
      {
        "name": "id",
        "dbType": "bigint unsigned",
        "nullable": false,
        "autoIncrement": true
      },
      {
        "name": "title",
        "dbType": "varchar(255)",
        "nullable": false,
        "default": ""
      },
      {
        "name": "slug",
        "dbType": "varchar(255)",
        "nullable": false,
        "default": ""
      },
      {
        "name": "description",
        "dbType": "text",
        "nullable": true
      },
      {
        "name": "user_work_description",
        "dbType": "text",
        "nullable": true,
        "comment": "Пользовательское поле: редактор описывает свою работу с записью (задача, статус, договорённости). Не для публичного сайта."
      },
      {
        "name": "price_from",
        "dbType": "decimal(10,2)",
        "nullable": true
      },
      {
        "name": "is_active",
        "dbType": "tinyint(1)",
        "nullable": false,
        "default": 1
      },
      {
        "name": "sort_order",
        "dbType": "int",
        "nullable": false,
        "default": 0
      },
      {
        "name": "published_at",
        "dbType": "datetime",
        "nullable": true
      },
      {
        "name": "created_at",
        "dbType": "datetime",
        "nullable": true
      },
      {
        "name": "updated_at",
        "dbType": "datetime",
        "nullable": true
      },
      {
        "name": "deleted_at",
        "dbType": "datetime",
        "nullable": true
      }
    ],
    "indexes": [
      {
        "name": "idx_services_slug",
        "type": "unique",
        "columns": [
          "slug"
        ]
      },
      {
        "name": "idx_services_is_active",
        "type": "index",
        "columns": [
          "is_active"
        ]
      },
      {
        "name": "idx_services_published_at",
        "type": "index",
        "columns": [
          "published_at"
        ]
      }
    ]
  },
  "relations": [
    {
      "name": "categories",
      "type": "belongsToMany",
      "targetTable": "categories",
      "pivotTable": "mm_category2service",
      "sourceKey": "service_id",
      "targetKey": "category_id",
      "pivotColumns": [
        "sort_order"
      ]
    },
    {
      "name": "files",
      "type": "belongsToMany",
      "targetTable": "files",
      "pivotTable": "mm_file2service",
      "sourceKey": "service_id",
      "targetKey": "file_id",
      "pivotColumns": [
        "role",
        "sort_order"
      ]
    }
  ],
  "adminSchema": {
    "navigation": {
      "module": "Контент",
      "group": "Услуги и цены",
      "icon": "list"
    },
    "listView": {
      "defaultColumns": [
        "id",
        "title",
        "is_active",
        "categories_count",
        "files_count",
        "updated_at"
      ],
      "compactColumns": [
        "id",
        "title",
        "categories_count",
        "files_count",
        "is_active"
      ],
      "defaultSort": [
        {
          "field": "updated_at",
          "direction": "desc"
        }
      ],
      "searchableFields": [
        "id",
        "title",
        "slug",
        "description"
      ],
      "facets": [
        {
          "field": "is_active",
          "type": "enum",
          "label": "Статус"
        },
        {
          "field": "categories",
          "type": "relation",
          "label": "Категории"
        },
        {
          "field": "files_count",
          "type": "range",
          "label": "Файлы"
        }
      ],
      "bulkActions": [
        "activate",
        "deactivate",
        "assign_category",
        "detach_category",
        "export_csv",
        "delete_soft"
      ]
    },
    "formView": {
      "sections": [
        {
          "id": "main",
          "title": "Основное",
          "fields": [
            "title",
            "slug",
            "description",
            "price_from",
            "is_active",
            "published_at",
            "sort_order"
          ]
        },
        {
          "id": "relations",
          "title": "Связи",
          "fields": [
            "categories",
            "files"
          ]
        },
        {
          "id": "editor_context",
          "title": "Работа над записью (пользовательское)",
          "fields": [
            "user_work_description"
          ]
        },
        {
          "id": "system",
          "title": "Системные",
          "fields": [
            "id",
            "created_at",
            "updated_at"
          ]
        }
      ],
      "fieldConfig": {
        "title": {
          "uiType": "text",
          "required": true,
          "maxLength": 255
        },
        "slug": {
          "uiType": "slug",
          "required": true,
          "unique": true
        },
        "description": {
          "uiType": "textarea",
          "rows": 5
        },
        "user_work_description": {
          "uiType": "textarea",
          "rows": 4,
          "label": "Описание работы (редактор)",
          "hint": "Свободный текст от пользователя админки: что делали с записью, что осталось, договорённости. Не для фронта.",
          "modelHint": "UserWorkNote — логический тип в метаданных; в БД может быть колонка user_work_description или отдельная таблица истории."
        },
        "price_from": {
          "uiType": "number",
          "step": 0.01,
          "min": 0
        },
        "is_active": {
          "uiType": "switch"
        },
        "published_at": {
          "uiType": "datetime"
        },
        "sort_order": {
          "uiType": "number",
          "step": 1
        },
        "categories": {
          "uiType": "relation-multi",
          "relationName": "categories",
          "displayField": "name"
        },
        "files": {
          "uiType": "file-relation-multi",
          "relationName": "files",
          "allowedMime": [
            "image/*",
            "application/pdf"
          ]
        }
      }
    },
    "filters": {
      "allowedOperators": {
        "title": [
          "contains",
          "starts_with",
          "equals",
          "empty"
        ],
        "price_from": [
          "equals",
          "gt",
          "gte",
          "lt",
          "lte",
          "between",
          "empty"
        ],
        "is_active": [
          "equals"
        ],
        "published_at": [
          "date_between",
          "date_before",
          "date_after",
          "empty"
        ],
        "categories": [
          "has_any",
          "has_all",
          "not_has"
        ],
        "files_count": [
          "equals",
          "gt",
          "gte",
          "lt",
          "lte"
        ]
      }
    },
    "importExport": {
      "import": {
        "formats": [
          "csv",
          "xlsx"
        ],
        "requiredColumns": [
          "title",
          "slug"
        ],
        "optionalColumns": [
          "description",
          "price_from",
          "is_active",
          "published_at",
          "categories",
          "files"
        ],
        "upsertBy": [
          "id",
          "slug"
        ]
      },
      "export": {
        "formats": [
          "csv",
          "xlsx"
        ],
        "defaultColumns": [
          "id",
          "title",
          "slug",
          "is_active",
          "price_from",
          "published_at",
          "categories_count",
          "files_count"
        ],
        "includeRelationsAs": {
          "categories": "names_csv",
          "files": "names_csv"
        }
      }
    }
  },
  "virtualFields": [
    {
      "name": "categories_count",
      "type": "computed-int",
      "source": "relation_count:categories",
      "description": "Количество связанных категорий"
    },
    {
      "name": "files_count",
      "type": "computed-int",
      "source": "relation_count:files",
      "description": "Количество прикрепленных файлов"
    }
  ],
  "apiDraft": {
    "basePath": "/api/admin/services",
    "endpoints": [
      {
        "method": "GET",
        "path": "/",
        "description": "Список с фильтрами, сортировкой, пагинацией"
      },
      {
        "method": "GET",
        "path": "/{id}",
        "description": "Детали записи + связи"
      },
      {
        "method": "POST",
        "path": "/",
        "description": "Создать запись"
      },
      {
        "method": "PUT",
        "path": "/{id}",
        "description": "Обновить запись"
      },
      {
        "method": "POST",
        "path": "/bulk",
        "description": "Массовые действия"
      },
      {
        "method": "POST",
        "path": "/import",
        "description": "Импорт csv/xlsx"
      },
      {
        "method": "GET",
        "path": "/export",
        "description": "Экспорт csv/xlsx"
      }
    ]
  }
}
