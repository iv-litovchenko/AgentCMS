# Agent CMS — конфигурация

awn_ui:
  default_landing_mode: configs

awn_settings:
  param_1: ""
  param_12: 0
  param_22: 0

awn_schema:
  topic:
    fields:
      field_1:
        type: awn.string
        name: Файл
      field_2:
        type: awn.string
        name: Файл 2
      field_3:
        type: awn.string
        name: Файл 3
        hint: Подсказка
        required: true
      field_4:
        type: awn.string
        name: field_4
      field_5:
        type: awn.string
        name: field_5
      field_6:
        type: awn.file
  settings:
    fields:
      field_1:
        type: awn.string
        name: field_1
      field_2:
        type: awn.string
        name: field_2
      field_3:
        type: awn.string
        name: field_3
      field_4:
        type: awn.string
        name: field_4
      field_5:
        type: awn.string
        name: field_5
      field_6:
        type: awn.string
