version: 1
layer: topic

awn_schema:
  topic:
    fields:
      # ── Текст ──
      demo_string:
        type: awn.field.string
        name: Строка
        hint: awn.field.string
      demo_email:
        type: awn.field.string.email
        name: Email
        hint: awn.field.string.email
      demo_slug:
        type: awn.field.string.slug
        name: Слаг
        hint: awn.field.string.slug
      demo_url:
        type: awn.field.string.url
        name: URL
        hint: awn.field.string.url
      demo_path:
        type: awn.field.string.link
        name: Путь в workspace
        hint: awn.field.string.link
      demo_text:
        type: awn.field.text
        name: Текст
        hint: awn.field.text
      demo_markdown:
        type: awn.field.text.markdown
        name: Markdown
        hint: awn.field.text.markdown

      # ── Числа ──
      demo_integer:
        type: awn.field.number.integer
        name: Целое
        hint: awn.field.number.integer
      demo_number:
        type: awn.field.number
        name: Число
        hint: awn.field.number

      # ── Выбор ──
      demo_boolean:
        type: awn.field.boolean
        name: Да / нет
        hint: awn.field.boolean
      demo_choice_one:
        type: awn.field.choice.one
        name: Один из списка (select)
        hint: awn.field.choice.one
        enum:
          - key: open
            name: Открыта
          - key: in_progress
            name: В работе
          - key: done
            name: Готово
      demo_choice_many:
        type: awn.field.choice.many
        name: Несколько из списка (checkbox)
        hint: awn.field.choice.many
        widget: checkbox
        enum:
          - key: alpha
            name: Alpha
          - key: beta
            name: Beta
          - key: gamma
            name: Gamma
      demo_tags_free:
        type: awn.field.array.tags
        name: Теги (свободные)
        hint: awn.field.array.tags

      # ── Дата и время ──
      demo_date:
        type: awn.field.date
        name: Дата
        hint: awn.field.date
      demo_datetime:
        type: awn.field.date.datetime
        name: Дата и время
        hint: awn.field.date.datetime

      # ── Медиа ──
      demo_color:
        type: awn.field.string.color
        name: Цвет (hex)
        hint: awn.field.string.color
      demo_file_one:
        type: awn.field.file.one
        name: Файл (один)
        hint: awn.field.file.one
        scope: all
      demo_file_many:
        type: awn.field.file.many
        name: Файлы (несколько)
        hint: awn.field.file.many
        scope: all
      demo_image_one:
        type: awn.field.file.image.one
        name: Изображение (одно)
        hint: awn.field.file.image.one
        scope: all
      demo_image_many:
        type: awn.field.file.image.many
        name: Изображения (несколько)
        hint: awn.field.file.image.many
        scope: all

      # ── Структура ──
      demo_json:
        type: awn.field.json
        name: JSON
        hint: awn.field.json
      demo_relation_one:
        type: awn.field.relation.one
        name: Связь (одна)
        hint: awn.field.relation.one
      demo_relation_many:
        type: awn.field.relation.many
        name: Связи (несколько)
        hint: awn.field.relation.many

      # ── Справочники (lookup) ──
      demo_lookup_status:
        type: awn.field.lookup.one
        source: statuses
        name: Lookup · статус
        hint: awn.field.lookup.one
      demo_lookup_category:
        type: awn.field.lookup.one
        source: categories
        name: Lookup · категория
        hint: awn.field.lookup.one + source categories
      demo_lookup_owner:
        type: awn.field.lookup.one
        source: users
        name: Lookup · владелец
        hint: awn.field.lookup.one + source users
      demo_lookup_priority:
        type: awn.field.lookup.one
        source: priorities
        name: Lookup · приоритет
        hint: awn.field.lookup.one + source priorities
      demo_lookup_color:
        type: awn.field.lookup.one
        source: colors
        value-kind: color
        name: Lookup · цвет
        hint: awn.field.lookup.one + source colors
      demo_lookup_tags:
        type: awn.field.lookup.many
        source: tags
        name: Lookup · теги
        hint: awn.field.lookup.many + source tags

      # ── CMS / платформа ──
      demo_cron:
        type: awn.field.string.cron-schedule
        name: Cron-расписание
        hint: awn.field.string.cron-schedule
      demo_entity_preview:
        type: awn.field.file.image.one.with-preview
        name: Превью сущности
        hint: awn.field.file.image.one.with-preview

  slot_memory:
    fields:
      rec_string:
        type: awn.field.string
        name: Строка
      rec_choice_one:
        type: awn.field.choice.one
        name: Choice one (radio)
        widget: radio
        enum:
          - key: draft
            name: Черновик
          - key: review
            name: Проверка
          - key: published
            name: Опубликовано
      rec_choice_many:
        type: awn.field.choice.many
        name: Choice many (select-multiple)
        widget: select-multiple
        enum:
          - key: one
            name: One
          - key: two
            name: Two
          - key: three
            name: Three
      rec_file:
        type: awn.field.file.one
        name: Файл
        scope: all
      rec_image:
        type: awn.field.file.image.one
        name: Изображение
        scope: all
      rec_relation:
        type: awn.field.relation.one
        name: Связь
      rec_lookup:
        type: awn.field.lookup.one
        source: priorities
        name: Lookup приоритет

  slot_memory_sidecar:
    fields:
      sidecar_string:
        type: awn.field.string
        name: Sidecar строка
      sidecar_boolean:
        type: awn.field.boolean
        name: Sidecar да/нет
      sidecar_lookup:
        type: awn.field.lookup.one
        source: tags
        name: Sidecar lookup тег
