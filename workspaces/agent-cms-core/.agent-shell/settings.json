{
  "formatVersion": 4,
  "cms": {
    "topicPath": "awn-agent-kit/agent/manifest.md",
    "channel": "thread"
  },
  "route": {
    "runtime": "qwenpaw",
    "runtimes": {
      "qwenpaw": {
        "type": "agent",
        "baseUrl": "http://127.0.0.1:8088",
        "agentId": "Aya",
        "sessionId": "agent-shell"
      }
    }
  },
  "voice": {
    "input": {
      "mode": "hold",
      "globalListen": false,
      "toCompose": false,
      "responseEnabled": true
    },
    "stt": {
      "lang": "ru-RU",
      "engine": "auto"
    },
    "tts": {
      "enabled": true,
      "playbackMode": "reading",
      "engine": "edge",
      "edgeVoice": "ru-RU-SvetlanaNeural",
      "rate": 1,
      "pitch": 1,
      "lang": "ru-RU",
      "stripEmoji": true,
      "includeCaptions": true,
      "elevenlabs": {
        "model": "eleven_multilingual_v2"
      }
    }
  },
  "proactive": {
    "enabled": false,
    "idleSeconds": 180,
    "cooldownSeconds": 900,
    "quietHours": {
      "enabled": false,
      "start": "23:00",
      "end": "07:00"
    }
  },
  "media": {
    "camera": {
      "enabled": false,
      "onSpeech": true,
      "facing": "user"
    },
    "screen": {
      "enabled": false,
      "onSpeech": true
    }
  },
  "window": {
    "topmost": true
  }
}
