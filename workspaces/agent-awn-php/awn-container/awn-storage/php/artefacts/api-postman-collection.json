{
  "info": {
    "name": "PHP Learning API",
    "description": "Демо-коллекция для темы PHP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "List posts",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/posts"
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" }
  ]
}
